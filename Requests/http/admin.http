@userId = 1
@role = USER
@driverId = 10
@driverUserId = 1
@licenseNumber = LIC-10
@driverStatus = APPROVED
@vehicleId = 20
@vehicleDriverId = 10
@plateNumber = TAX-20
@rideId = 30
@riderId = 1
@rideDriverId = 10
@rideStatus = REQUESTED

### Create user
POST {{host}}/api/admin/users
Content-Type: application/json

{
  "email": "user1@taxol.test",
  "name": "User 1",
  "password": "password123",
  "phoneNumber": "5550001",
  "role": "USER"
}

### Get all users
GET {{host}}/api/admin/users

### Get user by id
GET {{host}}/api/admin/users/{{userId}}

### Get users by role
GET {{host}}/api/admin/users/role/{{role}}

### Delete user
DELETE {{host}}/api/admin/users/{{userId}}

### Get all drivers
GET {{host}}/api/admin/drivers

### Get driver by id
GET {{host}}/api/admin/drivers/{{driverId}}

### Get driver by user id
GET {{host}}/api/admin/drivers/user/{{driverUserId}}

### Get driver by license number
GET {{host}}/api/admin/drivers/license/{{licenseNumber}}

### Get drivers by status
GET {{host}}/api/admin/drivers/status/{{driverStatus}}

### Update driver status
PATCH {{host}}/api/admin/drivers/{{driverId}}/status
Content-Type: application/json

{
  "status": "{{driverStatus}}"
}

### Get all vehicles
GET {{host}}/api/admin/vehicles

### Get vehicle by id
GET {{host}}/api/admin/vehicles/{{vehicleId}}

### Get vehicle by driver id
GET {{host}}/api/admin/vehicles/driver/{{vehicleDriverId}}

### Get vehicle by plate number
GET {{host}}/api/admin/vehicles/plate/{{plateNumber}}

### Get all rides
GET {{host}}/api/admin/rides

### Get ride by id
GET {{host}}/api/admin/rides/{{rideId}}

### Get rides by status
GET {{host}}/api/admin/rides/status/{{rideStatus}}

### Get rides by rider id
GET {{host}}/api/admin/rides/rider/{{riderId}}

### Get rides by driver id
GET {{host}}/api/admin/rides/driver/{{rideDriverId}}
