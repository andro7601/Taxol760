SPRING_APPLICATION_NAME=Taxol760
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://taxol760-db:5432/taxol760
SPRING_DATASOURCE_USERNAME=taxol760
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_JPA_OPEN_IN_VIEW=false

POSTGRES_DB=taxol760
POSTGRES_USER=taxol760
POSTGRES_PASSWORD=change-me

SPRING_DATA_REDIS_HOST=taxol760-redis:
SPRING_DATA_REDIS_PORT=6379

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=-1

SEEDED_ADMIN_JWT=generated-by-prettier-seeder-on-startup
SEEDED_USER_1_JWT=generated-by-prettier-seeder-on-startup
SEEDED_USER_2_JWT=generated-by-prettier-seeder-on-startup
SEEDED_DRIVER_1_JWT=generated-by-prettier-seeder-on-startup
SEEDED_DRIVER_2_JWT=generated-by-prettier-seeder-on-startup
SEEDED_DRIVER_3_JWT=generated-by-prettier-seeder-on-startup
